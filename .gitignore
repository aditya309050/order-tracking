# ==============================================================================
# GITIGNORE FOR ENTERPRISE ORDER TRACKING (REACT + NEXT/PAYLOAD + NODE)
# ==============================================================================

# 1. Dependency Directories (Prevents pushing huge binary modules > 100MB)
node_modules/
**/node_modules/
.pnp
.pnp.js

# 2. Production Build Outputs & Caches
dist/
**/dist/
dist-ssr/
build/
**/build/
out/
**/.next/
.next/
.turbo/
**/.turbo/

# 3. Local SQLite & Temporary Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
local-payload.db
**/local-payload.db
server/data/*.db
server/data/*.sqlite

# 4. Environment & Secret Configuration Files
.env
.env*.local
.env.production
.env.development
*.env
!.env.example
!**/.env.example

# 5. Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Operating System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 7. Antigravity / AI Agent Artifacts & Temporary Media
.tempmediaStorage/
**/browser/
**/.system_generated/
scratch/
