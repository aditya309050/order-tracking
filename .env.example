# ==============================================================================
# UNIFIED NEXT.JS + PAYLOAD CMS — ENVIRONMENT CONFIGURATION
# Add these in Vercel: Project Settings -> Environment Variables
# ==============================================================================

# --- Payload / Postgres (Supabase) -------------------------------------------
# Payload connects with the first of these that is set (non-pooling preferred).
POSTGRES_URL_NON_POOLING=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=postgres://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Secret used to sign Payload auth tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# --- Supabase browser client (used by the front-end pages) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Either the anon JWT or the new publishable key works for the browser client:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Vercel Blob (Payload Media uploads) -------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
BLOB_STORE_ID=store_xxxxxxxx
